{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",                       // <-- important for the "@/..." alias
    "paths": {
      "@/*": ["./*"]
    },
    "skipLibCheck": true,                 // <-- avoids type errors in node_modules
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "src/types/**/*.d.ts"                 // <-- make sure our shim is included
  ]
}
